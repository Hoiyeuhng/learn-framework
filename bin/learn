#!/usr/bin/env python3
"""Local learning workspace helpers. No model service or Python packages needed."""
import argparse
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile

FRAMEWORK = Path(__file__).resolve().parent.parent
MERMAID_VERSION = "11.17.0"


def git_root(path):
    result = subprocess.run(["git", "-C", str(path), "rev-parse", "--show-toplevel"],
                            text=True, capture_output=True)
    if result.returncode:
        raise ValueError(f"Not a Git workspace: {path}")
    return Path(result.stdout.strip()).resolve()


def workspace(path):
    root = git_root(Path(path).resolve() if path else Path.cwd())
    if root == FRAMEWORK:
        raise ValueError("Run this command from your learning workspace, outside the framework submodule.")
    installed = root / "framework"
    if not (installed / "AGENTS.md").is_file():
        raise ValueError("Initialize the submodule first: git submodule update --init --recursive")
    if installed.resolve() != FRAMEWORK:
        raise ValueError("Use this workspace's own framework/bin/learn, so its pinned version is used.")
    return root


def renderer_environment():
    env = os.environ.copy()
    # Kitty image placeholders encode image IDs as colors.
    env.pop("NO_COLOR", None)
    if not shutil.which("mmdc", path=env.get("PATH")):
        cache = Path(env.get("XDG_CACHE_HOME", str(Path.home() / ".cache")))
        for package in ("learn-framework", "learn"):
            directory = cache / package / f"mermaid-cli-{MERMAID_VERSION}" / "node_modules/.bin"
            if (directory / "mmdc").is_file():
                env["PATH"] = str(directory) + os.pathsep + env.get("PATH", "")
                break
    chrome = Path("/Applications/Google Chrome.app/Contents/MacOS/Google Chrome")
    if not env.get("PUPPETEER_EXECUTABLE_PATH") and chrome.is_file():
        env["PUPPETEER_EXECUTABLE_PATH"] = str(chrome)
    return env


def setup(root):
    pending = []
    for source in sorted((FRAMEWORK / "templates/workspace").iterdir()):
        target = root / source.name
        if target.exists() or target.is_symlink():
            if target.is_symlink() or not target.is_file() or target.read_bytes() != source.read_bytes():
                raise ValueError(f"Keep and reconcile the existing {target.name}; setup will not overwrite it.")
        else:
            pending.append((source, target))
    for source, target in pending:
        shutil.copyfile(source, target)
        print(f"Created {target.name}")
    print("Workspace entry points are ready. Open your AI tool from this workspace.")


def doctor(root, render=False):
    env = renderer_environment()
    problems = []
    for name in ("git", "python3"):
        found = shutil.which(name, path=env.get("PATH"))
        print(f"{'OK' if found else 'MISSING'} {name}")
        if not found:
            problems.append(name)
    for name in ("AGENTS.md", "CLAUDE.md", "preferences.md"):
        found = (root / name).is_file()
        print(f"{'OK' if found else 'MISSING'} {name}")
        if not found:
            problems.append(name)
    agent = any(shutil.which(name) for name in ("codex", "claude"))
    print("OK AI command found" if agent else "INFO No codex/claude command in PATH; use your installed app.")
    gh = shutil.which("gh")
    auth = gh and subprocess.run([gh, "auth", "status"], capture_output=True).returncode == 0
    print("OK GitHub CLI login" if auth else "INFO Install gh and run gh auth login for automatic PRs.")
    for name in ("presenterm", "pandoc", "typst", "mmdc", "tmux"):
        found = shutil.which(name, path=env.get("PATH"))
        print(f"{'OK' if found else 'OPTIONAL'} {name}")
        if render and not found and name != "tmux":
            problems.append(name)
    if render:
        print("INFO Renderer checks find commands only. Use the display smoke test to check browser and terminal support.")
    if env.get("TMUX") and shutil.which("tmux"):
        result = subprocess.run(["tmux", "show-options", "-gv", "allow-passthrough"], capture_output=True, text=True)
        print(f"INFO tmux allow-passthrough: {result.stdout.strip() or 'unknown'}")
    return bool(problems)


def present(root, topic, dry_run=False):
    if not re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*", topic):
        raise ValueError("Use a topic name with lowercase letters, digits, and hyphens.")
    directory = root / "topics" / topic
    lesson = directory / "lesson.md"
    if not lesson.resolve().is_relative_to(root) or not lesson.is_file():
        raise ValueError(f"No lesson found at topics/{topic}/lesson.md")
    env = renderer_environment()
    config = next((p for p in (directory / "display.yaml", root / "display.yaml") if p.is_file()), None)
    # Legacy topic configs stay relative to the workspace root, as in their original launchers.
    with tempfile.TemporaryDirectory(prefix="learn-display-") as temporary:
        if config is None:
            config = Path(temporary) / "display.yaml"
            config.write_text(
                "defaults:\n  theme: dark\n  image_protocol: auto\n"
                "  max_columns: 120\n  max_rows: 60\n  validate_overflows: always\n"
                "export:\n  dimensions:\n    columns: 120\n    rows: 60\n"
                "mermaid:\n  scale: 2\n  config_path: " + json.dumps(str(FRAMEWORK / "display/mermaid.json")) + "\n"
            )
        command = ["presenterm", "--config-file", str(config), str(lesson)]
        if dry_run:
            print(json.dumps({"cwd": str(root), "command": command,
                              "no_color": "NO_COLOR" in env,
                              "config": config.read_text()}, indent=2))
            return 0
        if not shutil.which("presenterm", path=env.get("PATH")):
            raise ValueError("Install presenterm first. See framework/docs/display.md.")
        return subprocess.call(command, cwd=root, env=env)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--workspace", help="Learning workspace path; default: Git root of current directory")
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("setup", help="Create missing workspace entry points without overwriting files")
    check = commands.add_parser("doctor", help="Check workspace files and optional tools")
    check.add_argument("--render", action="store_true", help="Require display tool commands")
    show = commands.add_parser("present", help="Show the topic lesson; reloads when the file changes")
    show.add_argument("topic")
    show.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()
    try:
        root = workspace(args.workspace)
        if args.command == "setup":
            setup(root)
            return 0
        if args.command == "doctor":
            return int(doctor(root, args.render))
        return present(root, args.topic, args.dry_run)
    except (ValueError, OSError) as error:
        print(f"Error: {error}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
