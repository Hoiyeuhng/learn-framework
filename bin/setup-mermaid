#!/bin/sh
set -eu
version=11.17.0
package_dir="${XDG_CACHE_HOME:-$HOME/.cache}/learn-framework/mermaid-cli-$version"
if [ -x "$package_dir/node_modules/.bin/mmdc" ]; then
    printf '%s\n' "Mermaid CLI $version is installed."
    exit 0
fi
if ! command -v npm >/dev/null 2>&1; then
    printf '%s\n' 'Install Node.js and npm before running setup-mermaid.' >&2
    exit 1
fi
# Use an existing Chrome installation when available; otherwise Puppeteer downloads a browser.
if [ -n "${PUPPETEER_EXECUTABLE_PATH:-}" ] || [ -x '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome' ]; then
    PUPPETEER_SKIP_DOWNLOAD=true
    export PUPPETEER_SKIP_DOWNLOAD
fi
exec npm install --prefix "$package_dir" --no-audit --no-fund "@mermaid-js/mermaid-cli@$version"
